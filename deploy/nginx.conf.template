# Веб и API на одном адресе: браузер ходит только сюда, /api уходит на сервис
# API. Так refresh-cookie остаётся SameSite=Strict, а CORS не нужен вовсе.
#
# Шаблон: при старте контейнера nginx подставляет переменные окружения.
#   PORT          - порт, который слушает веб (Railway задаёт свой).
#   API_UPSTREAM  - адрес API без пути: http://api:4000 в docker compose,
#                   http://<сервис>.railway.internal:4000 на Railway,
#                   https://<домен API> - если API в другом проекте.
# Адрес API разрешается на каждый запрос через DNS контейнера: сервис API
# перезапустился с новым адресом - веб перезапускать не нужно.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

# За балансировщиком Railway протокол исходного запроса приходит заголовком.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  '' $scheme;
}

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  # Скан документа и фото поломки - до 15 МБ.
  client_max_body_size 16m;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;

  set $api_upstream "${API_UPSTREAM}";

  location = /healthz {
    access_log off;
    return 200 'ok';
  }

  # Поток событий (SSE): без буферизации и с долгим ожиданием.
  location ~ ^/api/v1/properties/[^/]+/events$ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_ssl_server_name on;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_ssl_server_name on;
    proxy_read_timeout 60s;
  }

  # Файлы сборки с хешем в имени - навсегда в кэш браузера. Свой add_header
  # отменяет заголовки уровня server, поэтому они повторены здесь.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    add_header X-Content-Type-Options nosniff always;
    try_files $uri =404;
  }

  # Приложение одностраничное: любой путь отдаёт index.html, сам index - без кэша.
  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    try_files $uri /index.html;
  }
}
